<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:services="clr-namespace:AppUberContagem.Services"
             xmlns:helpers="clr-namespace:AppUberContagem.Helpers"
             x:Class="AppUberContagem.MainPage"
             Title="Principal"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <!-- Usamos um Grid principal em camadas (overlapping) para o Pop-up flutuante -->
    <Grid>
        <!-- Conteúdo Principal da Calculadora -->
        <Grid RowDefinitions="*,Auto" x:Name="MainGrid">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Label Text="🚗 Corrida" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                    <Label Text="Preço da corrida" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtPrecoCorrida" 
                           Placeholder="Ex.: 35,50" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Text="Distância até o passageiro (Km)" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtDistanciaAtePassageiro" 
                           Placeholder="Ex.: 2,5" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Text="Distância da corrida (Km)" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtDistancia" 
                           Placeholder="Ex.: 12,4" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Button x:Name="btnCalcular" Text="Calcular" BackgroundColor="#007BFF" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="BtnCalcular_Clicked"/>
                    <Button x:Name="btnLimpar" Text="Limpar" BackgroundColor="#DC3545" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="BtnLimpar_Clicked"/>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Banner AdMob fixo na parte inferior -->
            <admob:BannerAd Grid.Row="1"
                            x:Name="BottomBanner"
                            AdUnitId="{x:Static services:AdMobIds.BannerAdUnitId}"
                            AdSize="Banner"
                            HorizontalOptions="Fill"
                            OnAdFailedToLoad="OnBannerFailedToLoad" />
        </Grid>

        <!-- ========================================== -->
        <!-- POP-UP FLUTUANTE DE CENÁRIOS (INICIALMENTE OCULTO) -->
        <!-- ========================================== -->
        <Grid x:Name="PopupCenarios" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              InputTransparent="False"
              Padding="20">

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16"
                   HasShadow="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   Padding="15">

                <Grid RowDefinitions="Auto,*">
                    <!-- Cabeçalho do Pop-up com Botão de Fechar (X) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0" 
                               Text="📊 Comparativo por Cenário" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                        <Button Grid.Column="1" 
                                Text="✕" 
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                                BackgroundColor="Transparent"
                                HeightRequest="40"
                                WidthRequest="40"
                                CornerRadius="20"
                                Clicked="BtnFecharPopup_Clicked"
                                HorizontalOptions="End"/>
                    </Grid>

                    <!-- Conteúdo com os Cenários em ScrollView -->
                    <ScrollView Grid.Row="1" MaximumHeightRequest="450">
                        <VerticalStackLayout Spacing="12">

                            <Label Text="Toque em um cenário abaixo para aceitar e salvar a corrida" 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light=Gray, Dark=#A0A0A0}" 
                                   FontAttributes="Italic" 
                                   HorizontalOptions="Center" 
                                   Margin="0,0,0,5"/>

                            <!-- Cenário Urbano -->
                            <VerticalStackLayout Spacing="5" 
                                               BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#2A2A2A}" 
                                               Padding="12">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCenarioUrbanoTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="✅ 🏙️ Urbano (Padrão)" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosUrbano" Text="0,00 L" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoUrbano" Text="R$ 0,00" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroUrbano" Text="R$ 0,00" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Green, Dark=#2ECC71}" HorizontalOptions="End"/>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Cenário Misto -->
                            <VerticalStackLayout Spacing="5" 
                                               BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#2A2A2A}" 
                                               Padding="12">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCenarioMistoTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="✅ 🛣️ Misto (Avenidas/Fluido)" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosMisto" Text="0,00 L" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoMisto" Text="R$ 0,00" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroMisto" Text="R$ 0,00" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Green, Dark=#2ECC71}" HorizontalOptions="End"/>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Cenário Rodoviário -->
                            <VerticalStackLayout Spacing="5" 
                                               BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#2A2A2A}" 
                                               Padding="12">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCenarioRodoviarioTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="✅ 🛤️ Rodoviário (Estrada)" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosRodoviario" Text="0,00 L" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:" TextColor="{AppThemeBinding Light=#495057, Dark=#CCCCCC}"/>
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoRodoviario" Text="R$ 0,00" HorizontalOptions="End" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroRodoviario" Text="R$ 0,00" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Green, Dark=#2ECC71}" HorizontalOptions="End"/>
                                </Grid>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>