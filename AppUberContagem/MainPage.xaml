<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:services="clr-namespace:AppUberContagem.Services"
             xmlns:helpers="clr-namespace:AppUberContagem.Helpers"
             x:Class="AppUberContagem.MainPage"
             Title="Principal">

    <Grid RowDefinitions="*,Auto" x:Name="MainGrid">

        <!-- Área da Calculadora de Corrida -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="🚗 Corrida" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>

                <!-- AVISO DE COMBUSTÍVEL NÃO CONFIGURADO (Escondido por padrão) -->
                <Frame x:Name="frmAvisoCombustivel" 
                       BackgroundColor="#FFF3CD" 
                       BorderColor="#FFEEBA" 
                       CornerRadius="8" 
                       Padding="15" 
                       IsVisible="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" 
                               Text="⚠️" 
                               FontSize="20" 
                               VerticalOptions="Center" 
                               Margin="0,0,10,0"/>
                        <Label Grid.Column="1" 
                               Text="Combustível não configurado! Vá na aba 'Combustível' e salve os dados para calcular." 
                               TextColor="#856404" 
                               FontSize="14"
                               VerticalOptions="Center" 
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Frame>

                <Label Text="Preço da corrida" FontAttributes="Bold"/>
                <Entry x:Name="txtPrecoCorrida" Placeholder="Ex.: 35,50" Keyboard="Telephone">
                    <Entry.Behaviors>
                        <helpers:EntradaNumeroRealBehavior />
                    </Entry.Behaviors>
                </Entry>

                <Label Text="Distância até o passageiro (Km)" FontAttributes="Bold"/>
                <Entry x:Name="txtDistanciaAtePassageiro" Placeholder="Ex.: 2,5" Keyboard="Telephone">
                    <Entry.Behaviors>
                        <helpers:EntradaNumeroRealBehavior />
                    </Entry.Behaviors>
                </Entry>

                <Label Text="Distância da corrida (Km)" FontAttributes="Bold"/>
                <Entry x:Name="txtDistancia" Placeholder="Ex.: 12,4" Keyboard="Telephone">
                    <Entry.Behaviors>
                        <helpers:EntradaNumeroRealBehavior />
                    </Entry.Behaviors>
                </Entry>

                <Button x:Name="btnCalcular" Text="Calcular" BackgroundColor="#007BFF" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="BtnCalcular_Clicked"/>
                <Button x:Name="btnLimpar" Text="Limpar" BackgroundColor="#DC3545" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="BtnLimpar_Clicked"/>

                <BoxView HeightRequest="1" Color="Gray" Margin="0,10"/>

                <Label Text="📊 Comparativo por Cenário" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,5,0,0"/>

                <!-- Aviso visual de que é clicável -->
                <Label Text="Toque em um cenário abaixo para aceitar e salvar a corrida" FontSize="13" TextColor="Gray" FontAttributes="Italic" HorizontalOptions="Center" Margin="0,0,0,5"/>

                <!-- Cenário Urbano -->
                <VerticalStackLayout Spacing="5" BackgroundColor="#F1F3F5" Padding="12">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCenarioUrbanoTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="✅ 🏙️ Urbano (Padrão)" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosUrbano" Text="0,00 L" HorizontalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoUrbano" Text="R$ 0,00" HorizontalOptions="End"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroUrbano" Text="R$ 0,00" FontAttributes="Bold" TextColor="Green" HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Cenário Misto -->
                <VerticalStackLayout Spacing="5" BackgroundColor="#F1F3F5" Padding="12" Margin="0,5,0,0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCenarioMistoTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="✅ 🛣️ Misto (Avenidas/Fluido)" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosMisto" Text="0,00 L" HorizontalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoMisto" Text="R$ 0,00" HorizontalOptions="End"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroMisto" Text="R$ 0,00" FontAttributes="Bold" TextColor="Green" HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Cenário Rodoviário -->
                <VerticalStackLayout Spacing="5" BackgroundColor="#F1F3F5" Padding="12" Margin="0,5,0,0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCenarioRodoviarioTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="✅ 🛤️ Rodoviário (Estrada)" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Litros gastos:"/>
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblLitrosRodoviario" Text="0,00 L" HorizontalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Gasto combustível:"/>
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblGastoRodoviario" Text="R$ 0,00" HorizontalOptions="End"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Lucro / Resultado:" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblLucroRodoviario" Text="R$ 0,00" FontAttributes="Bold" TextColor="Green" HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Banner AdMob fixo na parte inferior -->
        <admob:BannerAd Grid.Row="1"
                        x:Name="BottomBanner"
                        AdUnitId="{x:Static services:AdMobIds.BannerAdUnitId}"
                        AdSize="Banner"
                        HorizontalOptions="Fill"
                        OnAdFailedToLoad="OnBannerFailedToLoad" />
    </Grid>
</ContentPage>