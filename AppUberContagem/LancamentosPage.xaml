<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:AppUberContagem.Helpers"
             x:Class="AppUberContagem.LancamentosPage"
             Title="Novo Lançamento"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="✍️ Adicionar Movimentação" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

            <Label Text="Tipo de Lançamento" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
            <Picker x:Name="pckTipo" 
                    Title="Selecione..." 
                    BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#1E1E1E}"
                    TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                    TitleColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Gasto</x:String>
                        <x:String>Ganho</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Categoria" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
            <Picker x:Name="pckCategoria" 
                    Title="Selecione..." 
                    BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#1E1E1E}"
                    TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                    TitleColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Combustível</x:String>
                        <x:String>Manutenção Preventiva (Óleo, Pneus)</x:String>
                        <x:String>Seguro / IPVA</x:String>
                        <x:String>Taxas / Pedágios</x:String>
                        <x:String>Ganhos Manuais / Particulares</x:String>
                        <x:String>Alimentação</x:String>
                        <x:String>Outros</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Descrição (Opcional)" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
            <Entry x:Name="txtDescricao" 
                   Placeholder="Ex: Gasolina do Mobi, Pedágio Indaiatuba..."
                   TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                   PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}"/>

            <Label Text="Valor (R$)" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
            <Entry x:Name="txtValor" 
                   Placeholder="Ex: 150,00" 
                   Keyboard="Numeric"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                   PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                <Entry.Behaviors>
                    <helpers:EntradaNumeroRealBehavior />
                </Entry.Behaviors>
            </Entry>

            <Label Text="Data da Movimentação" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
            <DatePicker x:Name="dtpData" 
                        Format="dd/MM/yyyy"
                        TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

            <Button Text="Salvar Lançamento" 
                    BackgroundColor="#28A745" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="50" 
                    Clicked="BtnSalvar_Clicked" 
                    Margin="0,15,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>