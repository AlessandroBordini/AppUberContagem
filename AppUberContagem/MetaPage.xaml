<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUberContagem.MetaPage"
             Title="Minhas Metas">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Label Text="🎯 Metas" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Acompanhe o seu progresso diário" FontSize="14" TextColor="Gray" HorizontalOptions="Center" Margin="0,-20,0,0"/>

            <!-- PAINEL DA META DIÁRIA -->
            <Frame BackgroundColor="#F8F9FA" BorderColor="#DFDFDF" CornerRadius="12" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Meta do Dia (Bruto)" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <!-- Barra de Progresso maior e mais visível -->
                    <ProgressBar x:Name="barMetaDiaria" Progress="0.0" ProgressColor="#28A745" HeightRequest="15" Margin="0,10"/>

                    <!-- Textos do Progresso -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label x:Name="lblGanhosHoje" Text="R$ 0,00" FontSize="22" FontAttributes="Bold" TextColor="#28A745" VerticalOptions="End"/>
                        <Label Text="/" FontSize="18" TextColor="Gray" VerticalOptions="End"/>
                        <Label x:Name="lblValorMeta" Text="R$ 200,00" FontSize="18" FontAttributes="Bold" TextColor="Gray" VerticalOptions="End"/>
                    </HorizontalStackLayout>

                    <Button Text="Definir Nova Meta" 
                            FontSize="14" 
                            Margin="0,15,0,0"
                            BackgroundColor="#007BFF" 
                            TextColor="White" 
                            CornerRadius="8"
                            Clicked="BtnDefinirMeta_Clicked"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>