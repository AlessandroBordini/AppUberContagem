<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppUberContagem.PremiumPage"
             Title="Versão Premium"
             BackgroundColor="{AppThemeBinding Light='#F8F9FA', Dark='#121212'}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="⭐" 
                       FontSize="42" 
                       HorizontalOptions="Center" />
                <Label Text="Desbloqueie o Potencial Máximo!" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center" />
                <Label Text="Torne-se Premium e tenha acesso a ferramentas exclusivas para motoristas." 
                       FontSize="14" 
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Lista de Funcionalidades Extras -->
            <Frame BorderColor="#E0E0E0" 
                   CornerRadius="12" 
                   Padding="16" 
                   HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✨ Benefícios Inclusos:" 
                           FontAttributes="Bold" 
                           FontSize="16" />

                    <Label Text="✔️ Relatório Financeiro Completo com filtros" FontSize="14" />
                    <Label Text="✔️ Exportação de relatórios em PDF" FontSize="14" />
                    <Label Text="✔️ Gestão avançada de ganhos e gastos extras" FontSize="14" />
                    <Label Text="✔️ Acompanhamento detalhado de metas" FontSize="14" />
                    <Label Text="✔️ Pagamento único (Acesso Vitalício)" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <!-- Indicador de Carregamento (Gira quando estiver processando) -->
            <ActivityIndicator x:Name="IndicadorCarregamento" 
                               IsRunning="False" 
                               IsVisible="False" 
                               Color="#27AE60" 
                               HeightRequest="40"
                               HorizontalOptions="Center" />

            <!-- Botão de Compra -->
            <Button x:Name="BtnComprar"
                    Text="Carregando preço..."
                    BackgroundColor="#27AE60"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="55"
                    Clicked="OnComprarClicked" />

            <!-- Mensagem de Sucesso (Fica escondida até o usuário comprar) -->
            <Label x:Name="LblSucesso"
                   Text="🎉 Você já é um usuário Premium!"
                   TextColor="#27AE60"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>