<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:services="clr-namespace:AppUberContagem.Services"
             xmlns:helpers="clr-namespace:AppUberContagem.Helpers"
             x:Class="AppUberContagem.CombustivelPage"
             Title="Combustível"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <Grid RowDefinitions="*,Auto">

        <!-- Área de Configuração -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Label Text="⛽ Configuração" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>

                <Label Text="Tipo de Veículo" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                <Picker x:Name="pckTipoVeiculo" 
                        SelectedIndex="0"
                        SelectedIndexChanged="PckTipoVeiculo_SelectedIndexChanged"
                        BackgroundColor="{AppThemeBinding Light=#F1F3F5, Dark=#1E1E1E}"
                        TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                        TitleColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Combustível (Gasolina/Álcool)</x:String>
                            <x:String>Elétrico</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <!-- Seção de Combustível (Gasolina/Álcool) -->
                <VerticalStackLayout x:Name="vslSecaoCombustivel" Spacing="15">
                    <Label Text="Combustível em uso" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>

                    <HorizontalStackLayout Spacing="30">
                        <RadioButton x:Name="rbGasolina" 
                                     Content="Gasolina" 
                                     GroupName="Combustivel" 
                                     IsChecked="True" 
                                     CheckedChanged="RbCombustivel_CheckedChanged"
                                     TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                        <RadioButton x:Name="rbAlcool" 
                                     Content="Álcool" 
                                     GroupName="Combustivel" 
                                     CheckedChanged="RbCombustivel_CheckedChanged"
                                     TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                    </HorizontalStackLayout>

                    <Label x:Name="lblKmGasolina" 
                           Text="Consumo na Gasolina (Km/L)" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtKmGasolina" 
                           Placeholder="Ex.: 12,5" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label x:Name="lblKmAlcool" 
                           Text="Consumo no Álcool (Km/L)" 
                           FontAttributes="Bold" 
                           IsVisible="False"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtKmAlcool" 
                           Placeholder="Ex.: 8,7" 
                           Keyboard="Telephone" 
                           IsVisible="False"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label x:Name="lblPrecoGasolina" 
                           Text="Preço do litro da Gasolina" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtPrecoGasolina" 
                           Placeholder="Ex.: 6,39" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label x:Name="lblPrecoAlcool" 
                           Text="Preço do litro do Álcool" 
                           FontAttributes="Bold" 
                           IsVisible="False"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtPrecoAlcool" 
                           Placeholder="Ex.: 4,49" 
                           Keyboard="Telephone" 
                           IsVisible="False"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>

                <!-- Seção de Elétrico -->
                <VerticalStackLayout x:Name="vslSecaoEletrico" IsVisible="False" Spacing="15">
                    <Label Text="Quanto custa a carga completa (R$)" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtPrecoCarga" 
                           Placeholder="Ex.: 30,00" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Text="Quantos KM roda com carga cheia (Km)" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#E0E0E0}"/>
                    <Entry x:Name="txtAutonomiaCarga" 
                           Placeholder="Ex.: 300" 
                           Keyboard="Telephone"
                           TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0A0}">
                        <Entry.Behaviors>
                            <helpers:EntradaNumeroRealBehavior />
                        </Entry.Behaviors>
                    </Entry>
                </VerticalStackLayout>

                <Button x:Name="btnSalvar" 
                        Text="Salvar Configuração" 
                        Clicked="BtnSalvar_Clicked" 
                        BackgroundColor="#007BFF" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="50"/>

                <Button x:Name="btnLimpar" 
                        Text="Limpar Tudo" 
                        BackgroundColor="#DC3545" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        Clicked="BtnLimpar_Clicked"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Banner AdMob fixo na parte inferior -->
        <admob:BannerAd Grid.Row="1"
                        x:Name="BottomBanner"
                        AdUnitId="{x:Static services:AdMobIds.BannerAdUnitId}"
                        AdSize="Banner"
                        HorizontalOptions="Fill"
                        OnAdFailedToLoad="OnBannerFailedToLoad" />
    </Grid>
</ContentPage>