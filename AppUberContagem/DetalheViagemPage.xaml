<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
             xmlns:services="clr-namespace:AppUberContagem.Services"
             x:Class="AppUberContagem.DetalheViagemPage"
             Title="Gerenciar Rota e Trechos"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <!-- Grid principal em camadas dividindo o conteúdo e o banner fixo embaixo -->
    <Grid RowDefinitions="*,Auto">

        <!-- Conteúdo Principal da Página (Linha 0) -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto, Auto, *, Auto" Padding="15">

            <!-- Cabeçalho da Viagem (Pai) -->
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label x:Name="lblNomeViagem" FontAttributes="Bold" FontSize="20" TextColor="Purple" />
                <Grid ColumnDefinitions="*, *" Margin="0,5">
                    <Label x:Name="lblTotalEstimado" FontSize="13" TextColor="Gray" />
                    <Label x:Name="lblSubtotalPendente" Grid.Column="1" FontSize="13" TextColor="Orange" HorizontalOptions="End" FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>

            <!-- Botão para Apagar a Viagem Inteira -->
            <Button Grid.Row="1" 
                    Text="🗑️ Excluir Esta Viagem Inteira" 
                    Clicked="BtnExcluirViagem_Clicked" 
                    BackgroundColor="#D9534F" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    FontSize="12"
                    Margin="0,5,0,5" />

            <!-- Botão para adicionar novo Trecho / Parada / Gasto -->
            <Button Grid.Row="2" 
                    Text="+ Adicionar Nova Cidade / Trecho / Gasto" 
                    Clicked="BtnAdicionarTrecho_Clicked" 
                    BackgroundColor="Purple" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    Margin="0,5,0,15" />

            <!-- Lista de Filhos (Trechos, Cidades, Pedágios) -->
            <CollectionView x:Name="cvItensViagem" Grid.Row="3">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="12" CornerRadius="8" HasShadow="False" BorderColor="#E0E0E0"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto, Auto">

                                <!-- Ícone indicativo do tipo -->
                                <Label Grid.RowSpan="2" Text="📍" FontSize="22" VerticalOptions="Center" Margin="0,0,10,0" />

                                <!-- Informações do Item -->
                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding Descricao}" FontAttributes="Bold" FontSize="14" />
                                <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="10" Margin="0,4,0,0">
                                    <Label Text="{Binding Valor, StringFormat='R$ {0:F2}'}" FontSize="13" TextColor="DarkSlateGray" FontAttributes="Bold" />
                                    <!-- Usando a propriedade StatusTexto diretamente do modelo -->
                                    <Label Text="{Binding StatusTexto}" FontSize="11" FontAttributes="Bold" TextColor="Gray" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Botões de Reorganização (Subir e Descer) -->
                                <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" Spacing="2" VerticalOptions="Center" Margin="0,0,8,0">
                                    <Button Text="▲" Clicked="BtnSubir_Clicked" CommandParameter="{Binding .}" BackgroundColor="#F0F0F0" TextColor="Black" FontSize="10" HeightRequest="26" WidthRequest="30" Padding="0" />
                                    <Button Text="▼" Clicked="BtnDescer_Clicked" CommandParameter="{Binding .}" BackgroundColor="#F0F0F0" TextColor="Black" FontSize="10" HeightRequest="26" WidthRequest="30" Padding="0" />
                                </VerticalStackLayout>

                                <!-- Ações Rápidas -->
                                <HorizontalStackLayout Grid.Column="3" Grid.RowSpan="2" Spacing="6" VerticalOptions="Center">
                                    <Button Text="✔️" 
                                            Clicked="BtnConfirmarGasto_Clicked" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="MediumSeaGreen"
                                            TextColor="White"
                                            HeightRequest="36" WidthRequest="42" FontSize="14" Padding="0" />
                                    <Button Text="✏️" Clicked="BtnEditar_Clicked" CommandParameter="{Binding .}" BackgroundColor="LightGray" HeightRequest="36" WidthRequest="36" Padding="0" />
                                    <Button Text="❌" Clicked="BtnExcluir_Clicked" CommandParameter="{Binding .}" BackgroundColor="LightCoral" HeightRequest="36" WidthRequest="36" Padding="0" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Rodapé explicativo -->
            <Label Grid.Row="4" Text="Use as setinhas (▲ ▼) para reordenar os trechos da viagem." 
                   FontSize="11" TextColor="Gray" HorizontalOptions="Center" Margin="0,10,0,0" />

        </Grid>

        <!-- Banner AdMob fixo na parte inferior (Linha 1) sem o evento conflitante -->
        <admob:BannerAd Grid.Row="1"
                        x:Name="BottomBanner"
                        AdUnitId="{x:Static services:AdMobIds.BannerAdUnitId}"
                        AdSize="Banner"
                        HorizontalOptions="Fill" />

    </Grid>
</ContentPage>