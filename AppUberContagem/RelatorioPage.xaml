<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppUberContagem"
             x:Class="AppUberContagem.RelatorioPage"
             Title="Relatório Financeiro"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">

    <ContentPage.Resources>
        <!-- Registra o conversor de cores para pintar Ganhos (Verde) e Gastos (Vermelho) -->
        <local:MovimentacaoColorConverter x:Key="ColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15" RowSpacing="12">

        <!-- 1. BOTÕES RÁPIDOS DE PERÍODO E ATUALIZAR -->
        <HorizontalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center">
            <Button x:Name="btnHoje" Text="Hoje" Clicked="BtnFiltroHoje_Clicked" BackgroundColor="#007BFF" TextColor="White" CornerRadius="8" HeightRequest="40"/>
            <Button x:Name="btnSemana" Text="Esta Semana" Clicked="BtnFiltroSemana_Clicked" BackgroundColor="#6C757D" TextColor="White" CornerRadius="8" HeightRequest="40"/>
            <Button x:Name="btnMes" Text="Este Mês" Clicked="BtnFiltroMes_Clicked" BackgroundColor="#6C757D" TextColor="White" CornerRadius="8" HeightRequest="40"/>
            <Button Text="🔄 Atualizar" Clicked="BtnAtualizar_Clicked" BackgroundColor="#17A2B8" TextColor="White" CornerRadius="8" HeightRequest="40"/>
        </HorizontalStackLayout>

        <!-- 2. DATAS DE INÍCIO E FIM + BOTÕES NOVO E EXPORTAR PDF -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, Auto, Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Início" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#A0A0A0}"/>
                <DatePicker x:Name="dtpInicio" DateSelected="OnDataFiltroChanged" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1">
                <Label Text="Fim" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#A0A0A0}"/>
                <DatePicker x:Name="dtpFim" DateSelected="OnDataFiltroChanged" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
            </VerticalStackLayout>

            <!-- Botão Novo -->
            <Button Grid.Column="2" Text="➕ Novo" VerticalOptions="End" BackgroundColor="#28A745" TextColor="White" Clicked="BtnNovoLancamento_Clicked" HeightRequest="42"/>

            <!-- Botão Exportar PDF -->
            <Button Grid.Column="3" Text="📄 PDF" VerticalOptions="End" BackgroundColor="#6C757D" TextColor="White" Clicked="OnExportarPdfClicked" HeightRequest="42"/>
        </Grid>

        <!-- 3. CARDS DE RESUMO DO PERÍODO -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <!-- Card Ganhos -->
            <VerticalStackLayout Grid.Column="0" 
                                 BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#0B2915}" 
                                 Padding="10" 
                                 Spacing="5">
                <Label Text="Ganhos" FontSize="12" TextColor="{AppThemeBinding Light=Green, Dark=#2ECC71}" FontAttributes="Bold"/>
                <Label x:Name="lblTotalGanhos" Text="R$ 0,00" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Green, Dark=#2ECC71}"/>
            </VerticalStackLayout>

            <!-- Card Gastos -->
            <VerticalStackLayout Grid.Column="1" 
                                 BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#381316}" 
                                 Padding="10" 
                                 Spacing="5">
                <Label Text="Gastos" FontSize="12" TextColor="{AppThemeBinding Light=Red, Dark=#E74C3C}" FontAttributes="Bold"/>
                <Label x:Name="lblTotalGastos" Text="R$ 0,00" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Red, Dark=#E74C3C}"/>
            </VerticalStackLayout>

            <!-- Card Lucro Líquido -->
            <VerticalStackLayout Grid.Column="2" 
                                 BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D243A}" 
                                 Padding="10" 
                                 Spacing="5">
                <Label Text="Líquido" FontSize="12" TextColor="{AppThemeBinding Light=Blue, Dark=#3498DB}" FontAttributes="Bold"/>
                <Label x:Name="lblLucroLiquido" Text="R$ 0,00" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Blue, Dark=#3498DB}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- 4. LISTA DE LANÇAMENTOS COM BOTÃO DE DELETAR -->
        <CollectionView Grid.Row="3" x:Name="cvRegistros">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" 
                           Margin="0,4" 
                           CornerRadius="8" 
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                           BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E1E}">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                            <!-- Detalhes do Lançamento -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding TipoMovimentacao}" FontAttributes="Bold" 
                                           TextColor="{Binding TipoMovimentacao, Converter={StaticResource ColorConverter}}"/>
                                    <Label Text="•" TextColor="{AppThemeBinding Light=Gray, Dark=#A0A0A0}"/>
                                    <Label Text="{Binding Categoria}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#212529, Dark=#FFFFFF}"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Descricao}" FontSize="13" TextColor="{AppThemeBinding Light=DimGray, Dark=#CCCCCC}"/>
                                <Label Text="{Binding Data, StringFormat='Data: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light=Gray, Dark=#A0A0A0}"/>
                            </VerticalStackLayout>

                            <!-- Valor -->
                            <Label Grid.Column="1" 
                                   Text="{Binding Valor, StringFormat='R$ {0:F2}'}" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{Binding TipoMovimentacao, Converter={StaticResource ColorConverter}}" 
                                   VerticalOptions="Center"/>

                            <!-- Botão de Apagar Registro -->
                            <Button Grid.Column="2" 
                                    Text="🗑️" 
                                    BackgroundColor="Transparent" 
                                    TextColor="Red" 
                                    CommandParameter="{Binding Id}"
                                    Clicked="BtnDeletar_Clicked"
                                    VerticalOptions="Center"
                                    WidthRequest="40"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>