<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppUberContagem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppUberContagem"
    Title="AppUberContagem">

    <!-- 1. Principal: Calculadora de Corrida -->
    <FlyoutItem Title="🚗 Corrida" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <!-- 2. Configuração de Combustível -->
    <FlyoutItem Title="⛽ Combustível" Route="CombustivelPage">
        <ShellContent ContentTemplate="{DataTemplate local:CombustivelPage}" />
    </FlyoutItem>

    <!-- 3. Acompanhamento de Metas -->
    <FlyoutItem x:Name="itemMetas" Title="🔒 Metas (PRO)" Route="MetaPage">
        <ShellContent ContentTemplate="{DataTemplate local:MetaPage}" />
    </FlyoutItem>

    <!-- 4. Relatório Financeiro -->
    <FlyoutItem x:Name="itemRelatorio" Title="🔒 Relatório Financeiro (PRO)" Route="RelatorioPage">
        <ShellContent ContentTemplate="{DataTemplate local:RelatorioPage}" />
    </FlyoutItem>

    <!-- 5. Conversão para Premium (Destaque Visual) -->
    <FlyoutItem Title="⭐ Seja Premium ⭐" Route="PremiumPage">
        <ShellContent ContentTemplate="{DataTemplate local:PremiumPage}" />
    </FlyoutItem>

</Shell>