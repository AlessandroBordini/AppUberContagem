<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppUberContagem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppUberContagem"
    Title="AppUberContagem">

    <FlyoutItem Title="Corrida" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Combustível" Route="CombustivelPage">
        <ShellContent ContentTemplate="{DataTemplate local:CombustivelPage}" />
    </FlyoutItem>

    <!-- Relatório Financeiro gerenciado via código para alternar o bloqueio -->
    <FlyoutItem x:Name="itemRelatorios" Title="🔒 Relatório Financeiro (PRO)" Route="RelatoriosPage" Icon="lock_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:RelatoriosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Seja Premium" Route="PremiumPage">
        <ShellContent ContentTemplate="{DataTemplate local:PremiumPage}" />
    </FlyoutItem>

</Shell>